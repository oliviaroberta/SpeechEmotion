{
  "classifier": {
    "C": 1.0,
    "class_weight": "balanced",
    "max_iter": 2000,
    "random_state": 42,
    "solver": "lbfgs",
    "standard_scaler": true
  },
  "embedding": {
    "hidden_size": 768,
    "pooling": ["mean", "population_standard_deviation"],
    "shape": [1536]
  },
  "encoder_batch_size": 4,
  "encoder_frozen": true,
  "emotion_labels": ["neutral", "calm", "happy", "sad", "angry", "fearful", "disgust", "surprised"],
  "input": {
    "feature_extractor_normalization": "pretrained_wav2vec2_default",
    "sample_rate": 16000,
    "waveform_samples": 56000
  },
  "model_identifier": "facebook/wav2vec2-base",
  "promotion_rule": {
    "minimum_validation_accuracy": 0.564167,
    "minimum_validation_macro_f1": 0.556975,
    "requires_both": true
  },
  "splits": {
    "train_actors": ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12", "13", "14", "15", "16"],
    "validation_actors": ["17", "18", "19", "20"]
  },
  "version": "1.0.0"
}
