{
  "configuration_version": "1.0.0",
  "frame_length": 2048,
  "hard_clipping_enabled": false,
  "output_dtype": "float32",
  "output_shape": [56000],
  "per_file_normalization_enabled": false,
  "processed_pcm_exported": false,
  "resample_method": "soxr_hq",
  "silence_top_db": 40,
