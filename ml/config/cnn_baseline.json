{
  "architecture": "cnn_baseline",
  "classes": [
    "neutral",
    "calm",
    "happy",
    "sad",
    "angry",
    "fearful",
    "disgust",
    "surprised"
  ],
  "compile": {
    "learning_rate": 0.001,
